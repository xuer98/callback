# Postgres connection. With a default Homebrew/Postgres.app install,
# `postgres://localhost:5432/callback` connects as your OS user.
DATABASE_URL=postgres://localhost:5432/callback

# Better Auth — session signing and cookie security. Required in production;
# in dev a missing secret falls back to a built-in default with a warning.
# Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's own public origin (no trailing slash). http://localhost:3000 in
# dev; your deployed URL in production.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (leave unset to hide the Google button)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# Admin console (/admin) — comma-separated sign-in emails allowed to add and
# edit problems. Leave unset to disable the console entirely (it 404s).
# ADMIN_EMAILS=you@example.com

# Anthropic — AI review for system-design submissions ("Submit for review"
# on system-design problems). Leave unset to disable: submissions fail with
# a clear message and everything else keeps working.
# Create a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Judge0 — server-side sandboxed code execution. Leave unset to run solutions
# in the browser instead (Web Worker fallback). JavaScript, TypeScript, and
# Python also run in the browser; Java, C++, and Go need Judge0.
# Self-hosted:  JUDGE0_URL=http://localhost:2358  (JUDGE0_API_KEY only if auth is enabled)
# RapidAPI:     JUDGE0_URL=https://judge0-ce.p.rapidapi.com  + JUDGE0_API_KEY=<your RapidAPI key>
JUDGE0_URL=
JUDGE0_API_KEY=
# Judge0 language ids. These are the Judge0 CE defaults — override any of them
# if your instance carries newer runtimes under different ids. TypeScript has
# no id of its own: it is transpiled and submitted as JavaScript.
# JUDGE0_JS_LANGUAGE_ID=63
# JUDGE0_PY_LANGUAGE_ID=71
# JUDGE0_JAVA_LANGUAGE_ID=62
# JUDGE0_CPP_LANGUAGE_ID=54
# JUDGE0_GO_LANGUAGE_ID=60