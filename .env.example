# Postgres connection. With a default Homebrew/Postgres.app install,
# `postgres://localhost:5432/callback` connects as your OS user.
DATABASE_URL=postgres://localhost:5432/callback

# Judge0 — server-side sandboxed code execution. Leave unset to run solutions
# in the browser instead (Web Worker fallback). JavaScript, TypeScript, and
# Python also run in the browser; Java, C++, and Go need Judge0.
# Self-hosted:  JUDGE0_URL=http://localhost:2358  (JUDGE0_API_KEY only if auth is enabled)
# RapidAPI:     JUDGE0_URL=https://judge0-ce.p.rapidapi.com  + JUDGE0_API_KEY=<your RapidAPI key>
JUDGE0_URL=
JUDGE0_API_KEY=
# Judge0 language ids. These are the Judge0 CE defaults — override any of them
# if your instance carries newer runtimes under different ids. TypeScript has
# no id of its own: it is transpiled and submitted as JavaScript.
# JUDGE0_JS_LANGUAGE_ID=63
# JUDGE0_PY_LANGUAGE_ID=71
# JUDGE0_JAVA_LANGUAGE_ID=62
# JUDGE0_CPP_LANGUAGE_ID=54
# JUDGE0_GO_LANGUAGE_ID=60